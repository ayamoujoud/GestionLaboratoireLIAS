<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Accès refusé</title><style>body{font-family:system-ui,sans-serif;background:#f5f7fb;display:grid;place-items:center;min-height:100vh;margin:0;color:#172033}.box{background:white;padding:36px;border-radius:16px;max-width:520px;text-align:center;box-shadow:0 10px 35px #17203318}a{display:inline-block;margin-top:18px;padding:10px 16px;background:#1d4ed8;color:white;text-decoration:none;border-radius:8px}</style></head><body><main class="box"><h1>Accès refusé</h1><p><%= request.getAttribute("messageAcces") == null ? "Vous n'avez pas les autorisations nécessaires." : request.getAttribute("messageAcces") %></p><a href="<%= request.getContextPath() %>/dashboard">Retour au tableau de bord</a></main></body></html>